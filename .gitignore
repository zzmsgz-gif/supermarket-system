
# npm 缓存（本机用 npm install --cache ./npm-cache 装依赖时产生）
# 267 个文件曾被提交进仓库，导致 .git 涨到 63MB —— 缓存可再生，不该入库
.npm-cache/

# 本机 npm 缓存目录（另一种常见位置）
.npm/_cacache/

# ===== 本机产生的日志/缓存/工具产物（都不该入库）=====
*.log
!.gitkeep

# Maven 本地仓库（曾误提交，体积大）
.m2/

# IDE
.idea/
*.iml
.vscode/

# 临时截图（本轮验证产物）
.shots/
_*.png
_addr_*.png
_img*/

# 我的备份目录（改数据前留的）
_bak_*/

# 拆分工具脚本的中产物（_split_*.py 的输出）
_b5out*.txt

# 构建产物
backend/target/
frontend/dist/
frontend/dist_*/

# 上传目录（本机联调产生）
backend/uploads/
uploads/

# Python 缓存
__pycache__/
*.pyc

# 真实配置（含凭证，必须只在本机）
backend/src/main/resources/application.yml

# 本机联调产物
*.err

# 依赖
node_modules/

# 拆分脚本的中间产物
*.b2out
*.b5out*
