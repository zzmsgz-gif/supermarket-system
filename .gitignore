!.env.example

# 含 OSS / DB / JWT 等密钥的本地配置，切勿提交到仓库
backend/src/main/resources/application.yml

# 部署/测试目录的非源码二进制与临时文件
deploy/**/*.png
deploy/**/*.err
deploy/**/*.jpg
deploy/**/*.jpeg
deploy/**/*.gif

# 仓库根目录顶层的调试/走查截图（历次前端走查产物，非源码）。
# 只匹配根目录，避免误伤 frontend/public 等处的正式图片。
/*.png
/*.jpg
/*.jpeg
/*.gif

# 编辑器/重构留下的备份，源码仓库不需要
*.bak
*.pre-extract
*.orig

# 本地运行/构建残留与上传产物（非源码，切勿提交）
target_del_*/
backend/uploads/
backend/test.png
backend/**/*.err
*.err
.shots/
