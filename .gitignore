.idea/
.vscode/
*.iml

target/
.m2/
out/
build/
dist/
node_modules/

*.log
backend-run.log
.env
.env.*

!.env.example

# 含 OSS / DB / JWT 等密钥的本地配置，切勿提交到仓库
backend/src/main/resources/application.yml

# 部署/测试目录的非源码二进制与临时文件
deploy/**/*.png
deploy/**/*.err
deploy/**/*.jpg
deploy/**/*.jpeg
deploy/**/*.gif

# 仓库根目录顶层的调试/走查截图（历次前端走查产物，非源码）。
# 只匹配根目录，避免误伤 frontend/public 等处的正式图片。
/*.png
/*.jpg
/*.jpeg
/*.gif

# 编辑器/重构留下的备份，源码仓库不需要
*.bak
*.pre-extract
*.orig

# 本地运行/构建残留与上传产物（非源码，切勿提交）
target_del_*/
backend/uploads/
backend/test.png
backend/**/*.err
*.err
.shots/

# Python 字节码缓存（部署脚本跑语法检查时会生成）
__pycache__/
*.pyc

# 巨型组件拆分过程中的产物（非源码）：
# dist_b*tmp/dist_deploy = 绕开被 Windows 锁住的 dist/ 时的临时构建输出；
# *.b2out/_b*out.txt = 拆分脚本的中间产物；*.bak_b* = 拆分前整份备份。
frontend/dist_b*tmp/
frontend/dist_deploy/
frontend/src/*.b2out
frontend/src/**/*.b2out
frontend/src/*.bak_b*
frontend/src/_b*
frontend/src/**/_b*
frontend/src/_appctx_*.txt
frontend/src/_locktest.txt
frontend/src/_writeprobe.txt
frontend/src/_verify_ids.py
frontend/src/*.new
frontend/src/*.test
_bak_20261005/
