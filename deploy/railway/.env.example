# ============================================================
# Railway 部署环境变量示例（复制到你 Railway 服务的 Variables）
# 形如 ${{MySQL.MYSQLHOST}} 的是 Railway 服务间变量引用，
# 在 Railway 控制台直接粘贴即可，部署时自动替换为真实值。
# ============================================================

# ---------------- backend 服务 ----------------
# 端口（Railway 自动注入，保留即可）
PORT=8080

# 数据源：用 MySQL 服务的私有网络变量拼出完整 JDBC 串
SPRING_DATASOURCE_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# JWT（务必改成你自己的强随机串，≥32 字节）
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_SECONDS=86400

# 新人券 id（与 init.sql 种子一致）
APP_NEW_USER_COUPON_ID=5

# Redis 缓存（不开 Redis 就保持 false）
APP_CACHE_ENABLED=false
SPRING_DATA_REDIS_HOST=${{Redis.REDIS_HOST}}
SPRING_DATA_REDIS_PORT=${{Redis.REDIS_PORT}}
SPRING_DATA_REDIS_PASSWORD=${{Redis.REDIS_PASSWORD}}

# JVM 堆（Railway/Hobby 内存受限时调小）
JAVA_OPTS=-Xmx512m -XX:+UseG1GC -XX:MaxMetaspaceSize=128m

# ---------------- frontend 服务 ----------------
# nginx 反代 /api 的目标（填 backend 服务的 Railway 公网域名）
BACKEND_URL=https://your-backend-service.up.railway.app
