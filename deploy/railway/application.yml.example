# ============================================================
# 云端部署用 application.yml 模板（Railway / 容器环境）
# ------------------------------------------------------------
# 本机开发请使用被 .gitignore 排除的真实 application.yml
# （该文件含 OSS 字面量密钥，切勿提交到仓库）。
#
# 云端部署步骤（二选一）：
#   1) 把本文件复制为 backend/src/main/resources/application.yml，
#      再执行 mvn package；或
#   2) 直接保留本文件，把所有密钥类字段通过环境变量注入
#      （推荐，见下方清单）。
#
# 必须注入的环境变量（未注入时使用冒号后的默认值）：
#   SPRING_DATASOURCE_URL   完整 JDBC 串（Railway MySQL 私有变量拼出）
#   DB_USERNAME / DB_PASSWORD
#   OSS_ENDPOINT / OSS_BUCKET / OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET / OSS_BASE_URL
#   JWT_SECRET               强随机值（openssl rand -base64 48）
#   APP_CACHE_ENABLED        是否开启 Redis 缓存（true/false）
#   SPRING_DATA_REDIS_HOST / PORT / PASSWORD
# ============================================================

server:
  port: ${PORT:8080}
  servlet:
    context-path: /api

spring:
  application:
    name: supermarket-backend
  datasource:
    url: ${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/supermarket_system?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false}
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:zzmsgz}
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
    show-sql: false
    properties:
      hibernate:
        format_sql: true
  servlet:
    multipart:
      max-file-size: 12MB
      max-request-size: 120MB

logging:
  level:
    org.hibernate.SQL: warn

# 文件存储配置
# storage.type: oss = 阿里云 OSS（默认，生产推荐）；local = 本地磁盘（联调用）
storage:
  type: ${STORAGE_TYPE:oss}
  local:
    dir: ${STORAGE_LOCAL_DIR:./uploads}
  oss:
    endpoint: ${OSS_ENDPOINT:https://oss-cn-beijing.aliyuncs.com}
    bucket: ${OSS_BUCKET:super-zzm}
    # 云端用环境变量注入真实密钥，切勿在此写死
    access-key-id: ${OSS_ACCESS_KEY_ID:CHANGE_ME}
    access-key-secret: ${OSS_ACCESS_KEY_SECRET:CHANGE_ME}
    base-url: ${OSS_BASE_URL:https://super-zzm.oss-cn-beijing.aliyuncs.com}

# Use an environment variable in production.
app:
  jwt:
    secret: ${JWT_SECRET:supermarket-local-dev-secret-change-me-32-bytes}
    expiration-seconds: ${JWT_EXPIRATION_SECONDS:86400}
  order:
    pay-timeout-minutes: ${ORDER_PAY_TIMEOUT_MINUTES:30}
    close-check-interval-ms: ${ORDER_CLOSE_CHECK_INTERVAL_MS:60000}
  new-user-coupon-id: ${APP_NEW_USER_COUPON_ID:5}
  cache:
    enabled: ${APP_CACHE_ENABLED:false}
  idempotency:
    ttl-seconds: ${APP_IDEMPOTENCY_TTL_SECONDS:300}
