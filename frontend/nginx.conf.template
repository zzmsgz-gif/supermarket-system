server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA history 路由回退（Vue Router history 模式）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 反代 /api 到后端服务。
    # Railway 注入 BACKEND_URL（例如 https://<backend>.up.railway.app）；
    # 未设置时默认本机 8080，方便本地 docker-compose 联调。
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;

        # 关键：Host 必须是后端的主机名，不能透传前端域名。
        # Railway 边缘按 Host 路由流量，若透传前端域名会把 /api 请求又绕回本服务 -> 502。
        proxy_set_header Host $proxy_host;
        # 后端是 HTTPS 共享边缘，须开启 SNI，否则 TLS 握手失败。
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
